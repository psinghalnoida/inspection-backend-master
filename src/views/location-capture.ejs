<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Share Location - ClaimsMitra</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      color: #fff;
    }
    
    .container {
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(10px);
      border-radius: 20px;
      padding: 40px 30px;
      max-width: 400px;
      width: 100%;
      text-align: center;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
    
    .logo {
      font-size: 28px;
      font-weight: bold;
      margin-bottom: 10px;
      color: #4ecdc4;
    }
    
    .survey-info {
      background: rgba(78, 205, 196, 0.1);
      border-radius: 12px;
      padding: 15px;
      margin: 20px 0;
      border: 1px solid rgba(78, 205, 196, 0.2);
    }
    
    .survey-info h3 {
      color: #4ecdc4;
      font-size: 14px;
      margin-bottom: 5px;
    }
    
    .survey-info p {
      font-size: 18px;
      color: #fff;
    }
    
    .welcome {
      font-size: 16px;
      color: #ccc;
      margin-bottom: 20px;
    }
    
    .status-card {
      padding: 30px;
      border-radius: 16px;
      margin: 20px 0;
    }
    
    .status-detecting {
      background: linear-gradient(135deg, rgba(78, 205, 196, 0.2), rgba(69, 183, 209, 0.2));
      border: 1px solid rgba(78, 205, 196, 0.3);
    }
    
    .status-success {
      background: linear-gradient(135deg, rgba(80, 200, 120, 0.2), rgba(34, 197, 94, 0.2));
      border: 1px solid rgba(80, 200, 120, 0.3);
    }
    
    .status-error {
      background: linear-gradient(135deg, rgba(239, 68, 68, 0.2), rgba(220, 38, 38, 0.2));
      border: 1px solid rgba(239, 68, 68, 0.3);
    }
    
    .spinner {
      width: 50px;
      height: 50px;
      border: 4px solid rgba(78, 205, 196, 0.3);
      border-top-color: #4ecdc4;
      border-radius: 50%;
      animation: spin 1s linear infinite;
      margin: 0 auto 20px;
    }
    
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
    
    .icon {
      font-size: 50px;
      margin-bottom: 15px;
    }
    
    .status-text {
      font-size: 18px;
      font-weight: 500;
      margin-bottom: 10px;
    }
    
    .status-subtext {
      font-size: 14px;
      color: #aaa;
    }
    
    .location-display {
      background: rgba(0, 0, 0, 0.2);
      padding: 15px;
      border-radius: 10px;
      margin-top: 15px;
      font-family: monospace;
      font-size: 14px;
      color: #4ecdc4;
    }
    
    .btn {
      padding: 14px 30px;
      border: none;
      border-radius: 10px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      width: 100%;
      margin-top: 20px;
      transition: all 0.3s;
    }
    
    .btn-primary {
      background: linear-gradient(135deg, #4ecdc4, #45b7d1);
      color: #fff;
    }
    
    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 15px rgba(78, 205, 196, 0.4);
    }
    
    .btn-retry {
      background: rgba(255, 255, 255, 0.1);
      color: #fff;
      border: 1px solid rgba(255, 255, 255, 0.2);
    }
    
    .hidden { display: none; }
    
    .footer {
      margin-top: 30px;
      font-size: 12px;
      color: #666;
    }
    
    .already-clicked {
      background: rgba(255, 193, 7, 0.1);
      border: 1px solid rgba(255, 193, 7, 0.3);
      padding: 15px;
      border-radius: 10px;
      margin: 20px 0;
    }
    
    .already-clicked p {
      color: #ffc107;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="logo">📍 ClaimsMitra</div>
    
    <div class="survey-info">
      <h3>Survey Reference</h3>
      <p><%= laid %></p>
    </div>
    
    <p class="welcome">Hello <strong><%= contact_person_name %></strong>,<br>
    Please share your current GPS location for the survey.</p>
    
    <% if (already_clicked) { %>
      <div class="already-clicked">
        <p>⚠️ Location has already been captured for this survey.</p>
      </div>
    <% } %>
    
    <!-- Initial State - Click to Start -->
    <div id="state-initial" class="status-card status-detecting">
      <div class="icon">📍</div>
      <p class="status-text">Share Your Location</p>
      <p class="status-subtext">Click the button below to share your GPS location</p>
      <button id="btn-get-location" class="btn btn-primary">📍 Get My Location</button>
    </div>
    
    <!-- Detecting State -->
    <div id="state-detecting" class="status-card status-detecting hidden">
      <div class="spinner"></div>
      <p class="status-text">Detecting your location...</p>
      <p class="status-subtext" id="detecting-subtext">Please allow location access when prompted</p>
      <button id="btn-cancel" class="btn btn-retry" style="margin-top:15px">Cancel</button>
    </div>
    
    <!-- Success State -->
    <div id="state-success" class="status-card status-success hidden">
      <div class="icon">✅</div>
      <p class="status-text">Location Captured!</p>
      <p class="status-subtext">Thank you! Your location has been shared.</p>
      <div class="location-display" id="location-display"></div>
    </div>
    
    <!-- Error State -->
    <div id="state-error" class="status-card status-error hidden">
      <div class="icon">❌</div>
      <p class="status-text" id="error-title">Location Error</p>
      <p class="status-subtext" id="error-message">Unable to get your location</p>
      <button id="btn-retry" class="btn btn-primary">🔄 Try Again</button>
    </div>
    
    <p class="footer">© <%= new Date().getFullYear() %> ClaimsMitra • Secure Location Sharing</p>
  </div>
  
  <script>
    // Debug logging
    console.log('Location page loaded');
    
    const smsToken = '<%= sms_token %>';
    const alreadyClicked = <%= JSON.stringify(already_clicked) %>;
    
    console.log('Token:', smsToken);
    console.log('Already clicked:', alreadyClicked);
    
    // State management
    function showState(state) {
      console.log('Showing state:', state);
      document.querySelectorAll('.status-card').forEach(el => el.classList.add('hidden'));
      const el = document.getElementById('state-' + state);
      if (el) {
        el.classList.remove('hidden');
        console.log('Found element for state:', state);
      } else {
        console.error('Element not found for state:', state);
      }
    }
    
    // Cancel and show initial
    function cancelAndRetry() {
      showState('initial');
    }
    
    // Get GPS location
    function getLocation() {
      console.log('getLocation() called');
      
      if (!navigator.geolocation) {
        console.error('Geolocation not supported');
        showError('Geolocation Not Supported', 'Your browser does not support GPS location.');
        return;
      }
      
      showState('detecting');
      document.getElementById('detecting-subtext').textContent = 'Please allow location access when prompted';
      
      // Set a timeout to show error if too slow
      const locationTimeout = setTimeout(() => {
        showError('Taking Too Long', 'GPS is slow. Try on mobile phone for faster detection.');
      }, 15000);
      
      navigator.geolocation.getCurrentPosition(
        (position) => {
          clearTimeout(locationTimeout);
          onLocationSuccess(position);
        },
        (error) => {
          clearTimeout(locationTimeout);
          onLocationError(error);
        },
        {
          enableHighAccuracy: true,
          timeout: 15000,
          maximumAge: 0
        }
      );
    }
    
    // Location success
    async function onLocationSuccess(position) {
      const lat = position.coords.latitude;
      const lng = position.coords.longitude;
      
      document.getElementById('detecting-subtext').textContent = 'Submitting location...';
      
      try {
        const response = await fetch('/api/v1/public/location/' + smsToken, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            latitude: lat,
            longitude: lng
          })
        });
        
        const data = await response.json();
        
        if (data.success) {
          showState('success');
          document.getElementById('location-display').textContent = 
            'Lat: ' + lat.toFixed(6) + ', Lng: ' + lng.toFixed(6);
        } else {
          showError('Submission Failed', data.message || 'Could not submit location');
        }
      } catch (err) {
        showError('Network Error', 'Please check your internet connection');
      }
    }
    
    // Location error
    function onLocationError(error) {
      let title = 'Location Error';
      let message = 'Unable to get your location';
      
      switch (error.code) {
        case 1: // PERMISSION_DENIED
          title = 'Permission Denied';
          message = 'Please enable location access in your browser settings';
          break;
        case 2: // POSITION_UNAVAILABLE
          title = 'Location Unavailable';
          message = 'GPS signal not available. Try on a mobile phone.';
          break;
        case 3: // TIMEOUT
          title = 'Request Timeout';
          message = 'Location detection took too long. Works better on mobile.';
          break;
      }
      
      showError(title, message);
    }
    
    function showError(title, message) {
      showState('error');
      document.getElementById('error-title').textContent = title;
      document.getElementById('error-message').textContent = message;
    }
    
    // Initial page load - show appropriate state
    if (alreadyClicked) {
      showState('error');
      document.getElementById('error-title').textContent = 'Already Captured';
      document.getElementById('error-message').textContent = 'Location was already submitted for this survey';
    } else {
      showState('initial');
    }
    
    // Add event listeners (CSP-compliant - no inline handlers)
    document.getElementById('btn-get-location').addEventListener('click', function() {
      console.log('Get Location button clicked');
      getLocation();
    });
    
    document.getElementById('btn-cancel').addEventListener('click', function() {
      console.log('Cancel button clicked');
      cancelAndRetry();
    });
    
    document.getElementById('btn-retry').addEventListener('click', function() {
      console.log('Retry button clicked');
      getLocation();
    });
  </script>
</body>
</html>
